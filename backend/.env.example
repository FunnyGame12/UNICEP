NODE_ENV=production
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unicep_prod_db
DB_USER=unicep_user
DB_PASSWORD=tu_password_seguro
JWT_SECRET=tu_jwt_secret_largo_y_unico
JWT_REFRESH_SECRET=tu_jwt_refresh_secret_largo_y_unico
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_ROOT=/var/www/UNICEP_STORAGE/uploads
CORS_ORIGIN=https://unicepmerida.com,https://www.unicepmerida.com
CSP_STRICT=true
CSP_SCRIPT_SRC='self','unsafe-eval'
CSP_STYLE_SRC='self','unsafe-inline'
CSP_IMG_SRC='self',data:,https:
CSP_FONT_SRC='self',data:
CSP_CONNECT_SRC='self',https:,wss:
CSP_REPORT_URI=
GOOGLE_DRIVE_CREDENTIALS_PATH=credentials.json
GOOGLE_DRIVE_ALUMNOS_ROOT_FOLDER_ID=<ID_CARPETA_MAESTRA_UNICEP>